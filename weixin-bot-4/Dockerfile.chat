FROM node:20-alpine

WORKDIR /app

COPY package.json ./
RUN npm install --production

COPY lib/ ./lib/
COPY linyou-chat-server.js .
COPY system-prompt-daily.txt .
COPY system-prompt-intimate.txt .
COPY system-prompt-pixel-home.txt .
COPY data/ ./data/

ENV DISABLE_PROXY=true
ENV MEMORY_DIR=/data2
ENV PORT=8080

EXPOSE 8080

CMD ["node", "linyou-chat-server.js"]
